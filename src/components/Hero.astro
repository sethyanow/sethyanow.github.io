---
interface Props {
  heading: string;
  subtitle: string;
}

const { heading, subtitle } = Astro.props;
---

<section class="py-24 md:py-32 px-4">
  <div class="max-w-4xl mx-auto text-center">
    <h1 class="text-5xl font-bold tracking-tight text-sand-900 mb-4 dark:text-sand-100">{heading}</h1>
    <p class="text-xl text-sand-600 max-w-2xl mx-auto dark:text-sand-400">{subtitle}</p>
  </div>
</section>
