---
interface Props {
  heading: string;
  subtitle: string;
}

const { heading, subtitle } = Astro.props;
---

<section class="py-32 md:py-40 px-4">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-6xl md:text-8xl font-bold tracking-tighter text-sand-900 mb-6 dark:text-sand-100">{heading}</h1>
    <p class="text-lg md:text-xl font-light text-sand-500 max-w-xl dark:text-sand-400">{subtitle}</p>
  </div>
</section>
