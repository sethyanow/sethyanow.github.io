---
const year = new Date().getFullYear();
---

<footer class="bg-sand-50 border-t border-sand-200 mt-auto dark:bg-sand-950 dark:border-sand-800">
  <div class="max-w-4xl mx-auto px-4 py-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-sm text-sand-500 dark:text-sand-400">
    <p>&copy; {year} Seth Yanow</p>
    <a
      href="https://github.com/sethyanow"
      class="hover:text-accent-600 transition-colors dark:hover:text-accent-400"
      target="_blank"
      rel="noopener noreferrer"
    >
      GitHub<span class="sr-only"> (opens in new tab)</span>
    </a>
  </div>
</footer>
