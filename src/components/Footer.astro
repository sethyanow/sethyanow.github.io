---
const year = new Date().getFullYear();
---

<footer class="bg-white border-t border-gray-200 mt-auto">
  <div class="max-w-4xl mx-auto px-4 py-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-sm text-gray-500">
    <p>&copy; {year} Seth Yanow</p>
    <a
      href="https://github.com/sethyanow"
      class="hover:text-blue-600 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
      target="_blank"
      rel="noopener noreferrer"
    >
      GitHub<span class="sr-only"> (opens in new tab)</span>
    </a>
  </div>
</footer>
