---
const navLinks = [
  { href: "/about", label: "About" },
  { href: "/projects", label: "Projects" },
];

const currentPath = Astro.url.pathname;
---

<header class="relative z-20 bg-sand-50 border-b border-sand-200 dark:bg-sand-950 dark:border-sand-800">
  <nav class="max-w-4xl mx-auto px-4 py-4 flex flex-wrap items-center justify-between">
    <a href="/" class="text-xl font-bold text-sand-900 hover:text-accent-600 transition-colors dark:text-sand-100 dark:hover:text-accent-400">
      Home
    </a>

    <button
      type="button"
      id="nav-toggle"
      class="md:hidden cursor-pointer p-2 text-sand-500 hover:text-sand-900 dark:text-sand-400 dark:hover:text-sand-100"
      aria-label="Toggle navigation"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
    <div
      id="nav-backdrop"
      class="fixed inset-0 bg-sand-900/30 hidden md:hidden z-10 dark:bg-sand-950/50"
      aria-hidden="true"
    ></div>

    <ul id="nav-menu" class="hidden basis-full flex-col relative z-20 pt-4 mt-4 border-t border-sand-200 md:flex md:basis-auto md:flex-row md:pt-0 md:mt-0 md:border-0 md:gap-6 dark:border-sand-800">
      {navLinks.map(({ href, label }) => {
        const isActive = currentPath === href || (href !== "/" && currentPath.startsWith(href + "/"));
        return (
          <li>
            <a
              href={href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "block py-2 md:py-0 transition-colors",
                isActive
                  ? "text-accent-600 font-semibold dark:text-accent-400"
                  : "text-sand-600 hover:text-accent-600 dark:text-sand-400 dark:hover:text-accent-400",
              ]}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");
  const backdrop = document.getElementById("nav-backdrop");

  function setOpen(open: boolean) {
    toggle?.setAttribute("aria-expanded", String(open));
    menu?.classList.toggle("hidden", !open);
    menu?.classList.toggle("flex", open);
    backdrop?.classList.toggle("hidden", !open);
    backdrop?.classList.toggle("block", open);
  }

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    setOpen(!open);
  });

  backdrop?.addEventListener("click", () => setOpen(false));
</script>
