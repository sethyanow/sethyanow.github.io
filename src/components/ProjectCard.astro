---
interface Props {
  name: string;
  description: string;
  url: string;
  tags?: string[];
}

const { name, description, url, tags = [] } = Astro.props;
---

<a
  href={url}
  class="block p-6 bg-white rounded-lg border border-gray-200 hover:border-blue-300 hover:shadow-md transition-colors transition-shadow focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
>
  <h3 class="text-lg font-semibold text-gray-900 mb-2">{name}</h3>
  <p class="text-gray-600 mb-3">{description}</p>
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="text-xs px-2 py-1 bg-blue-50 text-blue-700 rounded-full">
          {tag}
        </span>
      ))}
    </div>
  )}
</a>
