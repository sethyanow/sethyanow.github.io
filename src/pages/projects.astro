---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
---

<Layout title="Projects">
  <section class="max-w-4xl mx-auto px-4 pt-16 pb-24">
    <h1 class="text-4xl font-bold tracking-tight text-sand-900 mb-8 dark:text-sand-100">Projects</h1>
    <div class="grid gap-6 grid-cols-[repeat(auto-fit,minmax(min(100%,20rem),1fr))]">
      <ProjectCard
        name="markymark"
        description="Markdown workspace indexer with LSP and MCP support"
        url="/markymark/"
        tags={["Rust", "LSP", "MCP"]}
      />
    </div>
  </section>
</Layout>
