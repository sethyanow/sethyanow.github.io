---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
---

<Layout title="Home">
  <Hero
    heading="Seth Yanow"
    subtitle="Software engineer building tools for developers."
  />
  <section class="max-w-4xl mx-auto px-4 pb-16">
    <h2 class="sr-only">Welcome</h2>
    <p class="text-lg text-sand-600 text-center dark:text-sand-400">
      Welcome to my corner of the internet. Check out my
      <a href="/projects" class="text-accent-600 hover:underline dark:text-accent-400">projects</a>
      or learn more
      <a href="/about" class="text-accent-600 hover:underline dark:text-accent-400">about me</a>.
    </p>
  </section>
</Layout>
