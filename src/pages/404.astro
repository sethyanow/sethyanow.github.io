---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Not Found" description="This page doesn't exist.">
  <section class="py-24 md:py-32 px-4">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-5xl font-bold tracking-tight text-sand-900 mb-4 dark:text-sand-100">404</h1>
      <p class="text-xl text-sand-600 mb-8 dark:text-sand-400">This page doesn't exist.</p>
      <a
        href="/"
        class="text-accent-600 hover:underline dark:text-accent-400"
      >
        Back to home
      </a>
    </div>
  </section>
</Layout>
