---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About">
  <section class="max-w-4xl mx-auto px-4 py-20">
    <h1 class="text-4xl font-bold tracking-tight text-sand-900 mb-8 dark:text-sand-100">About</h1>
    <div class="max-w-2xl text-sand-600 space-y-4 dark:text-sand-400">
      <p>
        I'm a software engineer who enjoys building tools that make developers'
        lives easier. I care about good abstractions, reliable systems, and
        clean interfaces.
      </p>
      <p>
        This site is a work in progress. More details coming soon.
      </p>
    </div>
  </section>
</Layout>
